{
  "name": "hysb-bazaartracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "wrangler dev --test-scheduled --var ENVIRONMENT:development",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p web && tsc -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply bazaar --remote",
    "db:migrate:local": "wrangler d1 migrations apply bazaar --local",
    "backfill": "node --experimental-strip-types scripts/backfill.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
